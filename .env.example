# ==============================================================================
# SMART-TECH — Modèle de Variables d'Environnement (.env)
# ==============================================================================
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement :
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env

# --- SÉCURITÉ DE L'APPLICATION ---
# En production, générez une clé aléatoire complexe (ex: via python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-me-to-a-secure-random-key-in-production

# Mettre à False impérativement en production
DEBUG=False

# Liste des domaines autorisés séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,smart-tech.local

# Origines de confiance pour la protection CSRF (obligatoire avec HTTPS et proxys inverses Nginx/Traefik)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://smart-tech.local

# --- BASE DE DONNÉES ---
# Emplacement relatif ou absolu du fichier SQLite (par défaut db.sqlite3 à la racine)
DB_PATH=db.sqlite3

# --- SAUVEGARDE & RÉTENTION ---
# Répertoire de stockage des archives ZIP de sauvegarde
BACKUP_DIR=backups

# Nombre de jours avant purge des archives anciennes (par défaut 30 jours)
BACKUP_RETENTION_DAYS=30

# Nombre maximal de sauvegardes à conserver simultanément
BACKUP_MAX_COUNT=10

# Nombre de jours de conservation des logs du Journal d'Audit
AUDIT_LOG_RETENTION_DAYS=90

# --- PORT & HÉBERGEMENT ---
PORT=8000
