# ============================================
# EMAIL CONFIGURATION (POUR LES ALERTES)
# ============================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@yourapp.com
ADMIN_EMAIL=admin@yourapp.com

# ============================================
# REDIS (CACHING & CELERY)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ============================================
# CELERY (TÂCHES ASYNCHRONES)
# ============================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_FILE=/var/log/stock_management/app.log

# ============================================
# API & SECURITÉ
# ============================================

API_PAGINATION_SIZE=20
API_THROTTLE_RATE=1000/day
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# ============================================
# ML & PRÉDICTIONS
# ============================================

ML_DAYS_LOOKBACK=30
ML_MIN_DATA_POINTS=3
ML_PREDICTION_CONFIDENCE=0.7

# ============================================
# ALERTES
# ============================================

ALERT_EMAIL_ENABLED=False
ALERT_SMS_ENABLED=False
ALERT_WEBHOOK_URL=https://api.example.com/webhook

# ============================================
# MONITORING
# ============================================

SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
